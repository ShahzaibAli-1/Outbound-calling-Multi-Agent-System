PORT=3000
PUBLIC_BASE_URL=https://your-public-url.ngrok-free.app
AUTO_DETECT_NGROK=true

# Optional: used for browser prompt testing and patient intake extraction from transcripts
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Required: ElevenLabs Conversational AI agent handles live phone calls (STT + LLM + TTS)
# ELEVENLABS_AGENT_ID must belong to the same ElevenLabs account as ELEVENLABS_API_KEY.
# Check /api/health for available_agents if demo calls fail with "agent not found".
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
ELEVENLABS_OVERRIDE_PROMPT=true
ELEVENLABS_OVERRIDE_FIRST_MESSAGE=true
ELEVENLABS_VOICE_ID=aj0fZfXTBc7E3By4X8L2
ELEVENLABS_TTS_MODEL=eleven_turbo_v2

# Optional: if you import your Twilio number into ElevenLabs, set this to use native outbound calling
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000

AGENT_NAME=Medory Call Center
STAFF_NAME=Shahzaib
HARDCODED_PATIENT_NAME=Shahzaib Ali Khan
AGENT_GREETING=Hello, this is Medory Call Center. I have you on file as Shahzaib Ali Khan. What is your date of birth?
